# Copy to deployments/.env and fill in. Compose reads that file automatically.
#
# The secret variables are left empty on purpose. A commented-out placeholder
# that looks like a working credential eventually ends up deployed, and an
# empty one produces an error naming exactly the variable that is missing.

# --- application authentication -----------------------------------------
# Format: user:key:scope1,scope2;user2:key2
# The key is the bearer token a client sends as "Authorization: Bearer <key>".
# Scopes: bookings:read, bookings:write. A user without bookings:write may not
# search, hold, confirm or cancel.
AUTH_CREDENTIALS=

# --- supplier integration ----------------------------------------------
# Base URL of the booking supplier. Must be https outside local development.
SUPPLIER_BASE_URL=https://supplier.example.com
# Identifier this service uses to authenticate against the supplier.
SUPPLIER_ID=
# Secret issued by the supplier. Never commit it.
SUPPLIER_API_KEY=

# --- postgres -----------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=
DB_NAME=bookingdb
# Host port for postgres. Change it if 5432 is already taken locally.
DB_PORT=5432

# --- api ----------------------------------------------------------------
# Host port the API is published on. The container itself always listens on 8080,
# so only this side is configurable.
HTTP_PORT=8080
