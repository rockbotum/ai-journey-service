# Example configuration. Copy to .env and fill in real values.
# .env is git-ignored and must never be committed.
# Every variable below is documented: purpose, requiredness, safe default.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Runtime environment name. Optional. Default: development
# Used only for log decoration and error reporting.
APP_ENV=development

# ---------------------------------------------------------------------------
# HTTP API
# ---------------------------------------------------------------------------
# Listen address for the public API. Optional. Default: :8080
HTTP_LISTEN=:8080

# Maximum duration for reading a request. Optional. Default: 10s
# Bounds slow-client resource hold.
HTTP_READ_TIMEOUT=10s

# Maximum duration for writing a response. Optional. Default: 20s
HTTP_WRITE_TIMEOUT=20s

# Keep-alive idle timeout. Optional. Default: 60s
HTTP_IDLE_TIMEOUT=60s

# Graceful shutdown budget. Optional. Default: 15s
# After this deadline in-flight requests are abandoned.
HTTP_SHUTDOWN_TIMEOUT=15s

# Maximum accepted request body size in bytes. Optional. Default: 65536
# Prevents oversized payloads from reaching handlers.
HTTP_MAX_BODY_BYTES=65536

# Per-client request budget per minute. Optional. Default: 60
HTTP_REQUESTS_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# API credentials. Required. The service has no anonymous access.
#
# Format: a semicolon-separated list of entries, each shaped as
#   user_id:key:scope1,scope2
# A scope may contain a colon. Example:
#   AUTH_CREDENTIALS=partner_a:sk-partner-a-xxxx:bookings:write,bookings:read;partner_b:sk-partner-b-yyyy:bookings:write
#
# Keys are hashed at startup and never logged. They are never committed: keep
# real values in .env, which is git-ignored.
# Leave empty in this template on purpose.
AUTH_CREDENTIALS=

# ---------------------------------------------------------------------------
# External travel supplier
# ---------------------------------------------------------------------------
# These settings are required. A booking service that starts without a
# supplier would accept a user's intent and then fail at the moment it matters,
# so startup fails loudly instead.

# Supplier API root. Required.
SUPPLIER_BASE_URL=https://supplier.example.com

# Identifier stored with every result, so a booking can always be traced back
# to its source. Required.
SUPPLIER_ID=sup-1

# Outbound API key. Required. Never logged, never returned in an error, never
# committed. Leave empty in this template on purpose.
SUPPLIER_API_KEY=

# Budget for a single supplier attempt, including connection setup. Optional.
# Default: 8s
SUPPLIER_TIMEOUT=8s

# Retries after the first attempt. Optional. Default: 2
# Retries apply to transport errors and 5xx only. A financial call is never
# replayed automatically.
SUPPLIER_MAX_RETRIES=2

# First retry delay; it doubles each attempt. Optional. Default: 200ms
SUPPLIER_INITIAL_BACKOFF=200ms

# Upper bound on the retry delay. Optional. Default: 3s
# Must not be below SUPPLIER_INITIAL_BACKOFF.
SUPPLIER_MAX_BACKOFF=3s

# ---------------------------------------------------------------------------
# AI intent extraction
# ---------------------------------------------------------------------------
# Enables the AI boundary. Optional. Default: false
# When false, the service accepts structured requests only and never calls a
# model. Enabling it without the settings below fails at startup.
AI_ENABLED=false

# Base URL of the OpenAI-compatible endpoint. Required when AI_ENABLED=true.
# Example: https://api.example.com/v1
AI_BASE_URL=

# Model identifier. Required when AI_ENABLED=true.
AI_MODEL=

# API key for the model provider. Required when AI_ENABLED=true.
# Never logged, never returned in an error, never committed.
# Leave empty in this template on purpose.
AI_API_KEY=

# Path to the system prompt file. Required when AI_ENABLED=true.
# Kept in a file so it is reviewable in a pull request.
AI_SYSTEM_PROMPT_FILE=configs/ai_system_prompt.md

# Total budget for one model call including retries. Optional. Default: 15s
AI_TIMEOUT=15s

# Maximum retry attempts for a model call. Optional. Default: 2
# Retries apply to transport errors and 5xx only, never to a 4xx.
AI_MAX_RETRIES=2

# Upper bound on generated tokens, which bounds response size. Optional. Default: 1024
AI_MAX_OUTPUT_TOKENS=1024

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Connection string. Required.
# Use sslmode=verify-full in any non-local environment.
# Never logged, never returned in an error, never committed.
DB_DSN=

# Maximum open connections in the pool. Optional. Default: 10
DB_MAX_OPEN_CONNS=10

# Maximum idle connections in the pool. Optional. Default: 5
# Must not exceed DB_MAX_OPEN_CONNS.
DB_MAX_IDLE_CONNS=5

# Maximum lifetime of a pooled connection. Optional. Default: 30m
DB_CONN_MAX_LIFETIME=30m

# Server-side statement timeout. Optional. Default: 5s
# Defence in depth against a pathological query holding a connection.
DB_STATEMENT_TIMEOUT=5s
